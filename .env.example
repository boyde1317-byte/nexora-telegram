# ═══════════════════════════════════════════════════════════════════════
#  NEXORA MD v2.0 — Environment Configuration
#  Copy this file to .env and fill in your values: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── REQUIRED: Bot Owner Configuration ─────────────────────────────────────
# Comma-separated phone numbers without + or @s.whatsapp.net
# Example: "447911123456" or "233597514499,233533416608"
OWNER_NUMBERS="YOUR_PHONE_NUMBER"

# Super owner tier: can .logoutall and unpair ANY paired session.
# Comma-separated. Defaults to the first OWNER_NUMBERS entry when unset.
SUPER_OWNER_NUMBERS="YOUR_PHONE_NUMBER"

# Owner display name (shown in credits, about, etc.)
OWNER_NAME="Aizen"

# Default pairing phone number (must include country code, no + or spaces)
# Must be one of the numbers listed in OWNER_NUMBERS
PAIRING_PHONE="YOUR_PHONE_NUMBER"
# Max pairing codes per run for the main session (boot + /maincode); redeploy resets
PAIRING_BUDGET=10

# ── Connection Settings ──────────────────────────────────────────────────
# Set to "false" to use QR code instead of pairing code
PAIRING_ENABLED=true

# Reconnect limit (0 = unlimited, recommended for production)
RECONNECT_LIMIT=0

# Connection timeout in ms (default: 60000)
CONNECT_TIMEOUT=60000

# Keep-alive interval in ms (default: 30000)
KEEPALIVE_INTERVAL=30000

# ── Behavior Toggles ─────────────────────────────────────────────────────
# Auto-read incoming messages
AUTO_READ=true

# Public mode (anyone can use commands) vs self mode (owner only)
PUBLIC_MODE=true

# Auto-view status updates
AUTO_STATUS_VIEW=false

# ── Rate Limiting ────────────────────────────────────────────────────────
# Max commands per user per window
RATE_LIMIT_MAX=15

# Rate limit window in ms
RATE_LIMIT_WINDOW=30000

# Default command cooldown in ms
COMMAND_COOLDOWN=1500

# ── Database ─────────────────────────────────────────────────────────────
DB_PATH=./src/database/db.json
DB_AUTOSAVE_INTERVAL=60000

# ── AI Integration ────────────────────────────────────────────────────────
# Google Gemini API key — enables AI image generation and chat
GEMINI_API_KEY=""
# Platform-managed alias — either name works:
NEXORA_AI_KEY=""
# --- Alternative providers (used when no Gemini key is set) ---
# Groq — free API key: https://console.groq.com/keys (recommended free option)
GROQ_API_KEY=""
# Optional model overrides (defaults: llama-3.3-70b-versatile / meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_MODEL=""
# GROQ_VISION_MODEL=""
# Mistral — free API key: https://console.mistral.ai
MISTRAL_API_KEY=""
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Venice.ai — https://venice.ai/settings/api (credits required for inference)
# VENICE_API_KEY=""
# Optional model overrides (defaults: venice-uncensored-1-2 / z-ai-glm-5v-turbo)
# VENICE_MODEL=""
# VENICE_VISION_MODEL=""

# Set to "true" to generate AI assets on first startup
GENERATE_ASSETS=false

# ── Feature Flags ────────────────────────────────────────────────────────
# Toggle individual feature sets on/off
ENABLE_AI=true
ECONOMY_ENABLED=true
GREETINGS_ENABLED=true
NEWSLETTER_ENABLED=true
GAMES_ENABLED=true
DOWNLOADS_ENABLED=true
GROUP_MGMT_ENABLED=true
STATUS_ENABLED=true
ANTI_CALL=true
AUTO_RECOVERY=true
# Hot-reload plugins (auto-enabled in dev mode)
HOT_RELOAD=false

# ── Moderation ───────────────────────────────────────────────────────────
# Warning threshold before auto-removal
ANTILINK_WARN_THRESHOLD=3

# Mass-mention threshold for anti-tag
ANTITAG_THRESHOLD=10

# Warning expiry in ms (default: 24 hours)
WARN_EXPIRY=86400000

# ── XP / Economy ─────────────────────────────────────────────────────────
XP_MIN=5
XP_MAX=15
XP_COOLDOWN=60000
XP_ANNOUNCE=true
XP_LEVELUP_BONUS=50
DAILY_BASE_XP=100
DAILY_BASE_COINS=50
STREAK_MULTIPLIER=1.5
MAX_STREAK_BONUS=200

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_FILE=./nexora.log
# LOG_MAX_SIZE=10485760

# ── Web API Keys ────────────────────────────────────────────────────────
NEWS_API_KEY=""
SMMRY_API_KEY=""
OMDB_API_KEY=""

# ── WhatsApp Channel ─────────────────────────────────────────────────────
CHANNEL_JID=""

# ── Server Configuration ─────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# ENABLE_CORS=false

# ── Media ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=52428800
TEMP_DIR=/tmp/nexora-media

# Set to "production" for optimized module caching
NODE_ENV=production

# ── Telegram Control Panel (NEXORA Telegram port) ───────────────────────
# Leave TELEGRAM_BOT_TOKEN empty to run as a pure WhatsApp deployment.
# Token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""

# Owner's Telegram user id (from @userinfobot). Owner can /logoutall,
# /broadcast, /addadmin. Defaults to first TELEGRAM_ADMIN_IDS entry.
TELEGRAM_OWNER_ID=""

# Extra admins (comma-separated) — can pair/approve/deny/unpair/reload.
TELEGRAM_ADMIN_IDS=""

# Fleet size cap (default 50, max 50). Lower for small hosts.
MAX_EXTRA_SESSIONS=50

# ── api.jaky.dev (ephoto360 effects / CapCut & paper makers / Alight Motion) ──
# https://api.jaky.dev/playground
JAKY_API_KEY=""

# Free web pairing page (/pair)
WEB_PAIR_ENABLED=true
# 'free' = visitor gets a pairing code instantly
# 'request' = request queues behind admin approval (Telegram Approve/Deny card
#             + WhatsApp .pairapprove), code appears on the page once approved
WEB_PAIR_MODE=free
